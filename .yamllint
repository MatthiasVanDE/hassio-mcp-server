---
extends: default

rules:
  line-length:
    max: 120
    level: warning
  comments:
    min-spaces-from-content: 1
  truthy:
    check-keys: false
  document-start:
    present: true

# The workflows are linted too: they are the thing that publishes the image, so a
# YAML mistake there is a release that silently never happens.
ignore: |
  .ruff_cache/
